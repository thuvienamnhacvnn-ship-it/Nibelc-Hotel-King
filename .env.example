# Chuỗi kết nối PostgreSQL. Máy dev không cài được Postgres: chạy `npm run db:dev` (PGlite) rồi dùng giá trị này.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55480/postgres
# Cổng PGlite khi chạy `npm run db:dev`
DEV_PG_PORT=55480
# Thư mục ảnh tải lên (Đợt 2). Không đặt trong thư mục public.
UPLOAD_DIR=./uploads
# Đặt "1" khi chạy sau HTTPS để cookie phiên có cờ Secure
COOKIE_SECURE=0
# Múi giờ vận hành mặc định của tổ chức mới
DEFAULT_TIMEZONE=Europe/Budapest
